# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_db
SQLALCHEMY_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# NLP Models
SPACY_MODEL=en_core_web_sm
TRANSFORMER_MODEL=bert-base-uncased
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Vector Database
FAISS_INDEX_PATH=./models/faiss_index
USE_PINECONE=False
PINCONE_API_KEY=
PINCONE_ENVIRONMENT=gcp-starter
PINCONE_INDEX_NAME=chatbot-kb

# LLM Integration
OPENAI_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# Server Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# JWT/Auth
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Agent Configuration
ESCALATION_CONFIDENCE_THRESHOLD=0.5
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Knowledge Base
KB_SIMILARITY_THRESHOLD=0.7
KB_TOP_K_RESULTS=5
